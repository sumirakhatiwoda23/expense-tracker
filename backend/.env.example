PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=paisa
DB_PASSWORD=change_me
DB_NAME=paisa_ledger

# auto = PostgreSQL if DATABASE_URL is set, else MySQL, else SQLite
DB_CLIENT=auto

# PostgreSQL (production, e.g. Render). Leave unset locally to use MySQL/SQLite.
# DATABASE_URL=postgres://user:password@host:5432/database
# DATABASE_SSL=false

# Optional: point the SQLite fallback somewhere else
# DB_SQLITE_FILE=./data/paisa.db
